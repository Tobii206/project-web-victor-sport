<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Thống kê — VictorSport</title><link rel="icon" href="/logo/favicon-victorsport.svg">
<link rel="stylesheet" href="/css/victorsport.css?v=admin-20261014"><link rel="stylesheet" href="/css/tong-quan.css?v=20261023-ui-1"><link rel="stylesheet" href="/css/thong-ke.css?v=20261029-charts">
<link rel="stylesheet" href="/css/giao-dien-chung.css?v=20261023-type-2"><link rel="stylesheet" href="/css/thong-ke-mo-rong.css?v=20261029-charts-motion-1"></head><body><div class="app-shell"><jsp:include page="/WEB-INF/view/admin/layout/sidebar.jsp"/><div class="main-area">
<%@ include file="/WEB-INF/view/admin/layout/dashboard-header.jsp" %>
<main class="content-layout overview-page stats-page">
<section class="overview-intro"><div><p class="overview-eyebrow">KẾT QUẢ KINH DOANH</p><h2>Tổng quan bán hàng</h2><p class="muted">Theo dõi doanh thu, đơn hàng và sản phẩm bán chạy.</p></div><a class="button secondary stats-invoice-link" href="/quan-ly/hoa-don">Xem hóa đơn <span aria-hidden="true">↗</span></a></section>
<form class="overview-filter panel" method="get">
<div class="field"><label for="tuNgay">Từ ngày</label><input class="input" type="date" id="tuNgay" name="tuNgay" value="${tuNgay}" required></div>
<div class="field"><label for="denNgay">Đến ngày</label><input class="input" type="date" id="denNgay" name="denNgay" value="${denNgay}" required></div>
<div class="field"><label for="kenh">Kênh bán hàng</label><select class="select" id="kenh" name="kenh"><option value="tat-ca" ${kenh == 'tat-ca' ? 'selected' : ''}>Tất cả kênh bán</option><option value="online" ${kenh == 'online' ? 'selected' : ''}>Online</option><option value="quay" ${kenh == 'quay' ? 'selected' : ''}>Tại quầy</option></select></div>
<button class="button stats-filter-button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4"/></svg> Xem thống kê</button>
</form>
<c:if test="${not empty error}"><div class="alert error" role="alert" data-vs-flash="error"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty tongQuan}">
<div class="overview-cards">
<article class="overview-card featured"><div class="stats-card-top"><span>Doanh thu hoàn tất</span><i class="stats-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 9h18M16 14h2M6 5V3h11"/></svg></i></div><strong><fmt:formatNumber value="${tongQuan.doanh_thu}" maxFractionDigits="0"/> <em>đ</em></strong><small>Sau ưu đãi · gồm phí giao hàng</small></article>
<article class="overview-card"><div class="stats-card-top"><span>Đã hoàn tất</span><i class="stats-icon complete"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></i></div><strong>${tongQuan.hoan_tat}<em>đơn</em></strong><small>Đã hoàn tất hoặc khách đã nhận hàng</small></article>
<article class="overview-card"><div class="stats-card-top"><span>Đang xử lý</span><i class="stats-icon pending"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i></div><strong>${tongQuan.dang_xu_ly}<em>đơn</em></strong><small>Chờ xác nhận đến đang vận chuyển</small></article>
<article class="overview-card"><div class="stats-card-top"><span>Đã hủy</span><i class="stats-icon cancelled"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="m9 10 6 6M15 10l-6 6"/></svg></i></div><strong>${tongQuan.da_huy}<em>đơn</em></strong><small>Không tính vào doanh thu</small></article>
</div>

<div class="overview-cards stats-extra-cards">
<article class="overview-card"><span>Giá trị đơn trung bình</span><strong><fmt:formatNumber value="${tongQuan.trung_binh_don}" maxFractionDigits="0"/> <em>đ</em></strong><small>Doanh thu / số đơn hoàn tất</small></article>
<article class="overview-card"><span>Số đôi đã bán</span><strong><fmt:formatNumber value="${chiSo.so_doi}"/> <em>đôi</em></strong><small>Từ các đơn hoàn tất trong kỳ</small></article>
<article class="overview-card"><span>Khách có tài khoản đã mua</span><strong>${chiSo.khach_mua} <em>khách</em></strong><small>Không đếm trùng, không gồm khách vãng lai</small></article>
<article class="overview-card"><span>Tỷ lệ hủy đơn</span><strong><fmt:formatNumber value="${tongQuan.ty_le_huy}" maxFractionDigits="1"/> <em>%</em></strong><small>Đơn hủy / tổng đơn trong kỳ</small></article>
</div>
<section class="panel stats-chart-launchers"><div class="panel-header"><div><h2>Biểu đồ và báo cáo chi tiết</h2><p class="muted">Chọn nội dung để xem trong cửa sổ riêng.</p></div></div><div class="panel-body stats-launch-grid"><button type="button" class="stats-launch-button" data-stats-open="stats-xu-huong" aria-haspopup="dialog" aria-controls="stats-xu-huong"><span class="stats-launch-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18 8 12 13 15 21 5"/></svg></span><span><strong>Xu hướng bán hàng</strong><small>Biểu đồ đường · doanh thu và số đơn</small></span><span class="stats-launch-arrow" aria-hidden="true">↗</span></button>
<button type="button" class="stats-launch-button" data-stats-open="stats-doanh-thu" aria-haspopup="dialog" aria-controls="stats-doanh-thu"><span class="stats-launch-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V12M12 20V4M19 20V8"/></svg></span><span><strong>Doanh thu theo ngày</strong><small>Biểu đồ cột · bảng số liệu từng ngày</small></span><span class="stats-launch-arrow" aria-hidden="true">↗</span></button>
<button type="button" class="stats-launch-button" data-stats-open="stats-trang-thai" aria-haspopup="dialog" aria-controls="stats-trang-thai"><span class="stats-launch-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v9h9M9 3.6a9 9 0 1 0 11.4 11.4"/></svg></span><span><strong>Trạng thái đơn hàng</strong><small>Biểu đồ tròn · tiến độ xử lý đơn</small></span><span class="stats-launch-arrow" aria-hidden="true">↗</span></button>
<button type="button" class="stats-launch-button" data-stats-open="stats-kenh-ban" aria-haspopup="dialog" aria-controls="stats-kenh-ban"><span class="stats-launch-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v9l6.4 6.4M9 3.6a9 9 0 1 0 6-0"/></svg></span><span><strong>Doanh thu theo kênh</strong><small>Biểu đồ tròn · online và tại quầy</small></span><span class="stats-launch-arrow" aria-hidden="true">↗</span></button>
<button type="button" class="stats-launch-button" data-stats-open="stats-san-pham" aria-haspopup="dialog" aria-controls="stats-san-pham"><span class="stats-launch-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7 12 3 20 7v10l-8 4-8-4V7ZM4 7l8 4 8-4M12 11v10"/></svg></span><span><strong>Sản phẩm bán chạy</strong><small>Top 10 sản phẩm theo số đôi đã bán</small></span><span class="stats-launch-arrow" aria-hidden="true">↗</span></button>
<button type="button" class="stats-launch-button" data-stats-open="stats-khach-hang" aria-haspopup="dialog" aria-controls="stats-khach-hang"><span class="stats-launch-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0M17 3a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-3.9"/></svg></span><span><strong>Khách hàng mua nhiều</strong><small>Top 5 khách theo tổng chi tiêu</small></span><span class="stats-launch-arrow" aria-hidden="true">↗</span></button></div></section>
<div class="stats-extra stats-finance">
<section class="panel"><div class="panel-header"><h2>Thanh toán và ưu đãi</h2></div><div class="panel-body"><div class="summary-row"><span>Đã thu từ đơn hoàn tất</span><strong><fmt:formatNumber value="${chiSo.da_thu}" maxFractionDigits="0"/> đ</strong></div><div class="summary-row"><span>Còn phải thu từ đơn hoàn tất</span><strong><fmt:formatNumber value="${tongQuan.doanh_thu - chiSo.da_thu}" maxFractionDigits="0"/> đ</strong></div><div class="summary-row"><span>Ưu đãi trên đơn hoàn tất</span><strong><fmt:formatNumber value="${chiSo.uu_dai}" maxFractionDigits="0"/> đ</strong></div><div class="summary-row"><span>Phí giao hàng trên đơn hoàn tất</span><strong><fmt:formatNumber value="${chiSo.phi_ship}" maxFractionDigits="0"/> đ</strong></div><p class="overview-note">Tiền đã thu chỉ gồm giao dịch thành công. Đơn COD đã nhận hàng nhưng chưa đối soát vẫn nằm ở khoản phải thu.</p></div></section>
<section class="panel"><div class="panel-header"><div><h2>Tình hình tồn kho</h2><p class="muted">Hiện tại · không phụ thuộc bộ lọc ngày/kênh</p></div></div><div class="panel-body stats-stock"><div><strong>${tonKho.so_doi}</strong><span>Đôi còn trong kho</span></div><div><strong>${tonKho.sap_het}</strong><span>Mẫu còn 1–5 đôi</span></div><div><strong>${tonKho.het_hang}</strong><span>Mẫu hết hàng</span></div><a class="button secondary" href="/quan-ly/san-pham">Kiểm tra sản phẩm →</a></div></section>
</div>
<dialog id="stats-xu-huong" class="stats-dialog" aria-labelledby="stats-title-xu-huong"><div class="stats-dialog-heading"><div><h2 id="stats-title-xu-huong">Xu hướng bán hàng</h2><p>Từ <c:out value="${tuNgay}"/> đến <c:out value="${denNgay}"/> · ${kenh == 'online' ? 'Online' : kenh == 'quay' ? 'Tại quầy' : 'Tất cả kênh bán'}</p></div><button type="button" class="stats-dialog-close" data-stats-close aria-label="Đóng cửa sổ" autofocus>×</button></div><div class="stats-dialog-body"><section class="panel stats-line-panel" data-type="revenue">
<div class="panel-header"><div><h2>Xu hướng bán hàng</h2><p class="muted">Theo ngày tạo đơn · chỉ tính đơn hoàn tất</p></div><div class="stats-chart-tabs" role="group" aria-label="Chỉ số biểu đồ đường"><button type="button" data-line-type="revenue" aria-pressed="true">Doanh thu</button><button type="button" data-line-type="orders" aria-pressed="false">Số đơn</button></div></div>
<div class="panel-body"><div class="stats-line-data" hidden><c:forEach items="${bieuDo}" var="d"><span data-date="${d.ngay}" data-label="${d.nhan}" data-revenue="${d.doanh_thu}" data-orders="${d.so_don}"></span></c:forEach></div><div class="stats-line-canvas" role="img" aria-label="Biểu đồ đường doanh thu theo ngày"></div><p class="overview-note">Di chuột hoặc chọn điểm để xem số liệu. Xem bảng số liệu từng ngày trong mục Doanh thu theo ngày.</p></div>
</section></div></dialog>
<dialog id="stats-doanh-thu" class="stats-dialog" aria-labelledby="stats-title-doanh-thu"><div class="stats-dialog-heading"><div><h2 id="stats-title-doanh-thu">Doanh thu theo ngày</h2><p>Từ <c:out value="${tuNgay}"/> đến <c:out value="${denNgay}"/> · ${kenh == 'online' ? 'Online' : kenh == 'quay' ? 'Tại quầy' : 'Tất cả kênh bán'}</p></div><button type="button" class="stats-dialog-close" data-stats-close aria-label="Đóng cửa sổ" autofocus>×</button></div><div class="stats-dialog-body"><section class="panel stats-revenue"><div class="panel-header"><div><h2>Doanh thu theo ngày</h2><p class="muted">Chỉ tính đơn hoàn tất · lọc theo ngày tạo đơn</p></div><span class="stats-legend"><i></i> Doanh thu</span></div><div class="panel-body">
<c:set var="dinhDoanhThu" value="0"/><c:forEach items="${bieuDo}" var="d"><c:if test="${d.doanh_thu > dinhDoanhThu}"><c:set var="dinhDoanhThu" value="${d.doanh_thu}"/></c:if></c:forEach>
<c:set var="donViBieuDo" value="${dinhDoanhThu >= 1000000 ? 1000000 : 1000}"/>
<c:choose><c:when test="${tongQuan.hoan_tat > 0}">
<p class="stats-chart-unit">Đơn vị: ${dinhDoanhThu >= 1000000 ? 'triệu đồng' : 'nghìn đồng'}</p>
<div class="stats-chart-layout"><div class="stats-chart-axis" aria-hidden="true"><span><fmt:formatNumber value="${dinhDoanhThu / donViBieuDo}" maxFractionDigits="1"/></span><span><fmt:formatNumber value="${dinhDoanhThu * 0.75 / donViBieuDo}" maxFractionDigits="1"/></span><span><fmt:formatNumber value="${dinhDoanhThu * 0.5 / donViBieuDo}" maxFractionDigits="1"/></span><span><fmt:formatNumber value="${dinhDoanhThu * 0.25 / donViBieuDo}" maxFractionDigits="1"/></span><span>0</span></div>
<div class="revenue-chart" role="list" aria-label="Doanh thu từng ngày"><c:forEach items="${bieuDo}" var="d"><div class="revenue-day" role="listitem" title="${d.ngay}: ${d.doanh_thu} đ · ${d.so_don} đơn"><div class="revenue-track"><span style="height:${d.cao}%"></span></div><small>${d.nhan}</small></div></c:forEach></div></div>
</c:when><c:otherwise><div class="stats-empty"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3v18h17M8 16v-3M13 16V9M18 16V6"/></svg><h3>Chưa có doanh thu trong kỳ</h3><p>Đơn hoàn tất sẽ được tổng hợp tại đây.</p></div></c:otherwise></c:choose>
<details class="overview-details"><summary>Xem số liệu từng ngày <span aria-hidden="true">↓</span></summary><div class="overview-table"><table class="table"><thead><tr><th>Ngày</th><th>Đơn hoàn tất</th><th class="money">Doanh thu</th></tr></thead><tbody><c:forEach items="${bieuDo}" var="d"><tr><td>${d.ngay}</td><td>${d.so_don}</td><td class="money"><fmt:formatNumber value="${d.doanh_thu}"/> đ</td></tr></c:forEach></tbody></table></div></details>
</div></section></div></dialog>
<dialog id="stats-trang-thai" class="stats-dialog" aria-labelledby="stats-title-trang-thai"><div class="stats-dialog-heading"><div><h2 id="stats-title-trang-thai">Trạng thái đơn hàng</h2><p>Từ <c:out value="${tuNgay}"/> đến <c:out value="${denNgay}"/> · ${kenh == 'online' ? 'Online' : kenh == 'quay' ? 'Tại quầy' : 'Tất cả kênh bán'}</p></div><button type="button" class="stats-dialog-close" data-stats-close aria-label="Đóng cửa sổ" autofocus>×</button></div><div class="stats-dialog-body"><section class="panel stats-pie-panel"><div class="panel-header"><div><h2>Cơ cấu trạng thái đơn</h2><p class="muted">Tất cả trạng thái trong kỳ đã chọn</p></div></div><div class="panel-body stats-pie" data-format="count"><div class="stats-pie-canvas" role="img" aria-label="Biểu đồ tròn trạng thái đơn hàng"></div><ul class="stats-pie-legend">
<li data-value="${tongQuan.cho_xac_nhan}" data-label="Chờ xác nhận"><span>Chờ xác nhận</span><strong>${tongQuan.cho_xac_nhan}</strong></li>
<li data-value="${tongQuan.da_xac_nhan}" data-label="Đã xác nhận"><span>Đã xác nhận</span><strong>${tongQuan.da_xac_nhan}</strong></li>
<li data-value="${tongQuan.chuan_bi}" data-label="Chuẩn bị hàng"><span>Chuẩn bị hàng</span><strong>${tongQuan.chuan_bi}</strong></li>
<li data-value="${tongQuan.van_chuyen}" data-label="Đang vận chuyển"><span>Đang vận chuyển</span><strong>${tongQuan.van_chuyen}</strong></li>
<li data-value="${tongQuan.hoan_tat}" data-label="Hoàn tất"><span>Hoàn tất</span><strong>${tongQuan.hoan_tat}</strong></li>
<li data-value="${tongQuan.da_huy}" data-label="Đã hủy"><span>Đã hủy</span><strong>${tongQuan.da_huy}</strong></li>
</ul></div></section><section class="panel stats-orders"><div class="panel-header"><div><h2>Tình trạng đơn</h2><p class="muted">${tongQuan.so_don} đơn trong kỳ đã chọn</p></div></div><div class="panel-body">
<div class="stats-order-total"><strong>${tongQuan.so_don}</strong><span>Tổng đơn hàng</span></div>
<div class="stats-order-status complete"><div><span><i></i>Đã hoàn tất</span><strong>${tongQuan.hoan_tat}</strong></div><div class="stats-progress"><span style="width:${tongQuan.so_don > 0 ? tongQuan.hoan_tat * 100 / tongQuan.so_don : 0}%"></span></div></div>
<div class="stats-order-status pending"><div><span><i></i>Đang xử lý</span><strong>${tongQuan.dang_xu_ly}</strong></div><div class="stats-progress"><span style="width:${tongQuan.so_don > 0 ? tongQuan.dang_xu_ly * 100 / tongQuan.so_don : 0}%"></span></div></div>
<div class="stats-order-status cancelled"><div><span><i></i>Đã hủy</span><strong>${tongQuan.da_huy}</strong></div><div class="stats-progress"><span style="width:${tongQuan.so_don > 0 ? tongQuan.da_huy * 100 / tongQuan.so_don : 0}%"></span></div></div>
<p class="stats-completion"><strong><fmt:formatNumber value="${tongQuan.so_don > 0 ? tongQuan.hoan_tat * 100 / tongQuan.so_don : 0}" maxFractionDigits="0"/>%</strong> đơn hàng đã hoàn tất</p>
</div></section></div></dialog>
<dialog id="stats-kenh-ban" class="stats-dialog" aria-labelledby="stats-title-kenh-ban"><div class="stats-dialog-heading"><div><h2 id="stats-title-kenh-ban">Doanh thu theo kênh</h2><p>Từ <c:out value="${tuNgay}"/> đến <c:out value="${denNgay}"/> · ${kenh == 'online' ? 'Online' : kenh == 'quay' ? 'Tại quầy' : 'Tất cả kênh bán'}</p></div><button type="button" class="stats-dialog-close" data-stats-close aria-label="Đóng cửa sổ" autofocus>×</button></div><div class="stats-dialog-body"><section class="panel stats-pie-panel"><div class="panel-header"><div><h2>Doanh thu theo kênh bán</h2><p class="muted">Tỷ trọng doanh thu từ đơn hoàn tất</p></div></div><div class="panel-body stats-pie" data-format="money"><div class="stats-pie-canvas" role="img" aria-label="Biểu đồ tròn doanh thu online và tại quầy"></div><ul class="stats-pie-legend"><c:forEach items="${theoKenh}" var="k"><li data-value="${k.doanh_thu}" data-label="${k.kenh}"><span><c:out value="${k.kenh}"/><small>${k.so_don} đơn</small></span><strong><fmt:formatNumber value="${k.doanh_thu}" maxFractionDigits="0"/> đ</strong></li></c:forEach><c:if test="${empty theoKenh}"><li class="muted">Chưa có doanh thu trong kỳ.</li></c:if></ul></div></section></div></dialog>
<dialog id="stats-san-pham" class="stats-dialog" aria-labelledby="stats-title-san-pham"><div class="stats-dialog-heading"><div><h2 id="stats-title-san-pham">Sản phẩm bán chạy</h2><p>Từ <c:out value="${tuNgay}"/> đến <c:out value="${denNgay}"/> · ${kenh == 'online' ? 'Online' : kenh == 'quay' ? 'Tại quầy' : 'Tất cả kênh bán'}</p></div><button type="button" class="stats-dialog-close" data-stats-close aria-label="Đóng cửa sổ" autofocus>×</button></div><div class="stats-dialog-body"><section class="panel stats-bestsellers"><div class="panel-header"><div><h2>Sản phẩm bán chạy</h2><p class="muted">Xếp hạng theo số đôi bán ra từ đơn hoàn tất</p></div><span class="overview-pill">Top 10 sản phẩm</span></div><div class="panel-body"><div class="overview-table"><table class="table"><thead><tr><th>#</th><th>Sản phẩm</th><th>Số đôi đã bán</th><th class="money">Tiền hàng</th></tr></thead><tbody>
<c:forEach items="${banChay}" var="sp" varStatus="st"><tr><td><span class="overview-rank rank-${st.count}">${st.count}</span></td><td><a href="/quan-ly/san-pham/${sp.id}"><c:out value="${sp.ten_san_pham}"/></a><div class="muted"><c:out value="${sp.ma_san_pham}"/></div></td><td><div class="stats-sold"><strong>${sp.so_luong}</strong><div class="stats-sold-bar"><span style="width:${banChay[0].so_luong > 0 ? sp.so_luong * 100 / banChay[0].so_luong : 0}%"></span></div></div></td><td class="money"><fmt:formatNumber value="${sp.tien_hang}"/> đ</td></tr></c:forEach>
<c:if test="${empty banChay}"><tr><td colspan="4" class="overview-empty">Chưa có sản phẩm bán ra trong các đơn hoàn tất.</td></tr></c:if>
</tbody></table></div><p class="overview-note">Tiền hàng theo giá trên hóa đơn, trước ưu đãi cấp hóa đơn và phí vận chuyển.</p></div></section></div></dialog>
