<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trả hàng và hoàn tiền — VictorSport</title>
<link rel="stylesheet" href="/css/victorsport.css?v=20261107-balanced"><link rel="stylesheet" href="/css/giao-dien-chung.css?v=20261107-readable"><link rel="stylesheet" href="/css/admin-theme.css?v=20261112-jsp-3">
<style>.table-scroll{overflow:auto}.return-admin-form{display:grid;grid-template-columns:1fr 1fr;gap:18px}.return-admin-form .wide{grid-column:1/-1}.return-admin-form label{display:block;font-weight:600;color:#61758e;margin:0 0 8px}.return-admin-form textarea{min-height:95px}.return-refund-input{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.return-refund-input .input{flex:1 1 180px;min-width:0}.return-refund-input .button{white-space:nowrap}.return-admin-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.return-evidence{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}.return-evidence img{width:110px;height:110px;object-fit:cover;border:1px solid #dfe7f2;border-radius:12px}.return-request-info{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}.return-request-info section{padding:18px;background:#f7f9fc;border:1px solid #e2e9f2;border-radius:14px}.return-progress{padding-left:22px}.return-progress li{padding:8px 0;color:#657c97}.return-pagination{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:22px}.return-pagination .current{background:#142d50;color:white}.return-refund-note{padding:14px 18px;background:#fff5eb;border:1px solid #ffe2c8;border-radius:12px;color:#a8662f}.return-price{color:#e86620;font-weight:800;font-size:24px}@media(max-width:760px){.return-admin-form,.return-request-info{grid-template-columns:1fr}}</style></head>
<body class="admin-page"><div class="app-shell"><jsp:include page="/WEB-INF/view/admin/layout/sidebar.jsp"/><div class="main-area">
<header class="topbar"><div class="topbar-heading"><jsp:include page="/WEB-INF/view/admin/layout/menu-toggle.jsp"/><div><h1>Trả hàng &amp; hoàn tiền</h1><div class="muted">VictorSport</div></div></div><div class="topbar-user"><jsp:include page="/WEB-INF/view/admin/layout/store-link.jsp"/><a class="admin-user-chip" href="/tai-khoan"><c:out value="${currentUser.hoTen}"/></a></div></header>
<main class="content-layout"><section class="panel"><div class="panel-header"><h2>${not empty yeuCau ? yeuCau.ma_yeu_cau : (xemHangLoi ? 'Hàng trả bị lỗi' : 'Danh sách yêu cầu')}</h2><div class="return-admin-actions"><a class="button secondary" href="/quan-ly/tra-hang">Danh sách yêu cầu</a><a class="button secondary" href="/quan-ly/tra-hang/hang-loi">Hàng lỗi tách riêng</a></div></div><div class="panel-body">
<c:if test="${not empty error}"><div class="alert error" role="alert" data-vs-flash="error"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert success" role="status" data-vs-flash="success"><c:out value="${success}"/></div></c:if>
<c:choose><c:when test="${not empty yeuCau}">
<div class="return-request-info"><section><h3>Thông tin yêu cầu</h3><p><strong>Đơn hàng:</strong> <a href="/quan-ly/hoa-don/${don.id}"><c:out value="${don.ma_hoa_don}"/></a></p><p><strong>Khách hàng:</strong> <c:out value="${don.ten_khach_hang}"/></p><p><strong>Trạng thái:</strong> <c:out value="${yeuCau.ten_trang_thai}"/></p><p><strong>Lý do:</strong> <c:out value="${yeuCau.ly_do}"/></p><p><c:out value="${yeuCau.ghi_chu}"/></p><p>${yeuCau.hinh_thuc_tra == 'GUI_HANG' ? 'Gửi hàng về' : 'Trả trực tiếp tại cửa hàng'} <c:out value="${yeuCau.hang_van_chuyen}"/> <c:out value="${yeuCau.ma_van_don}"/></p></section>
<section><h3>Thông tin hoàn tiền</h3><p class="return-price"><fmt:formatNumber value="${yeuCau.so_tien_hoan}" maxFractionDigits="2"/> đ</p><p>${yeuCau.phuong_thuc_hoan == 'BANK' ? 'Chuyển khoản ngân hàng' : 'Tiền mặt tại cửa hàng'}</p><c:if test="${yeuCau.phuong_thuc_hoan == 'BANK'}"><p><c:out value="${yeuCau.ngan_hang}"/> · <c:out value="${yeuCau.so_tai_khoan}"/></p><p><c:out value="${yeuCau.chu_tai_khoan}"/></p></c:if><c:forEach items="${hoanTien}" var="h"><p>Mã giao dịch: <strong><c:out value="${h.ma_giao_dich}"/></strong></p><p><fmt:formatDate value="${h.ngay_tao}" pattern="dd/MM/yyyy HH:mm"/></p></c:forEach></section></div>
<div class="return-evidence"><c:forEach items="${anh}" var="a"><a href="/quan-ly/tra-hang/${yeuCau.id}/anh/${a.id}" target="_blank" rel="noopener"><img src="/quan-ly/tra-hang/${yeuCau.id}/anh/${a.id}" alt="Ảnh minh chứng"></a></c:forEach></div>
<form data-return-approval method="post" action="/quan-ly/tra-hang/${yeuCau.id}/xu-ly" ${yeuCau.trang_thai == 'DA_DUYET_HOAN_TRA' ? 'data-vs-confirm="Bạn đã hoàn đúng số tiền cho khách và muốn ghi nhận hoàn tiền?"' : ''}><input type="hidden" name="csrf" value="<c:out value='${csrfTraHang}'/>">
<div class="table-scroll"><table class="table"><thead><tr><th>STT</th><th>Duyệt trả</th><th>Sản phẩm</th><th>Trả</th><th>Tiền hoàn</th><th>Đạt / nhập lại kho</th><th>Hàng lỗi</th></tr></thead><tbody><c:forEach items="${dongTra}" var="d" varStatus="st"><tr><td>${st.count}</td><td><c:choose><c:when test="${yeuCau.trang_thai == 'CHO_XAC_NHAN' or (yeuCau.trang_thai == 'DANG_KIEM_TRA' and d.duoc_duyet)}"><input type="checkbox" name="duyet_${d.id}" value="1" data-return-choice data-row="${d.id}" data-amount="${d.so_tien_hoan}" ${not empty formXuLy ? (formXuLy['duyet_'.concat(d.id)] == '1' ? 'checked' : '') : (yeuCau.trang_thai == 'DANG_KIEM_TRA' ? 'checked' : '')} aria-label="Duyệt trả sản phẩm ${st.count}"></c:when><c:otherwise><span class="muted">${yeuCau.trang_thai == 'TU_CHOI' ? 'Từ chối' : (d.duoc_duyet ? 'Đã duyệt' : 'Không duyệt')}</span></c:otherwise></c:choose></td><td><strong><c:out value="${d.ten_san_pham}"/></strong><div class="muted"><c:out value="${d.gioi_tinh}"/> · <c:out value="${d.ten_mau_sac}"/> · <c:out value="${d.ten_kich_thuoc}"/></div></td><td>${d.so_luong}</td><td><fmt:formatNumber value="${yeuCau.trang_thai != 'CHO_XAC_NHAN' and (yeuCau.trang_thai == 'TU_CHOI' or not d.duoc_duyet) ? 0 : d.so_tien_hoan}" maxFractionDigits="2"/> đ</td><td><c:choose><c:when test="${yeuCau.trang_thai == 'DANG_KIEM_TRA' and d.duoc_duyet}"><input class="input" name="nhap_${d.id}" data-return-stock="${d.id}" data-return-quantity="${d.so_luong}" type="number" min="0" max="${d.so_luong}" step="1" required aria-label="Số lượng đạt kiểm tra" value="<c:out value='${formXuLy["nhap_".concat(d.id)]}'/>"></c:when><c:otherwise>${d.so_luong_nhap}</c:otherwise></c:choose></td><td><c:choose><c:when test="${yeuCau.trang_thai == 'DANG_KIEM_TRA' and d.duoc_duyet}"><input class="input" name="loi_${d.id}" data-return-fault="${d.id}" data-return-quantity="${d.so_luong}" type="number" min="0" max="${d.so_luong}" step="1" required aria-label="Số lượng hàng lỗi" value="<c:out value='${formXuLy["loi_".concat(d.id)]}'/>"></c:when><c:otherwise>${d.so_luong_loi}</c:otherwise></c:choose></td></tr></c:forEach></tbody></table></div>
<c:if test="${yeuCau.trang_thai == 'CHO_XAC_NHAN' or yeuCau.trang_thai == 'DANG_KIEM_TRA'}"><div class="return-admin-actions" style="margin-top:16px"><label><input type="checkbox" data-return-select-all> Chọn tất cả sản phẩm có thể duyệt</label><strong data-return-selected-total>Chọn sản phẩm được duyệt trả</strong></div><p class="muted">Chỉ sản phẩm được tick mới được trả và hoàn tiền. Nếu bỏ sản phẩm, hãy ghi rõ lý do. Nhập số lượng đạt hoặc hàng lỗi, ô còn lại tự tính. Tổng hai ô phải bằng số lượng trả; hàng lỗi không cộng vào kho bán.</p></c:if>
<c:if test="${yeuCau.trang_thai != 'DA_HOAN_TIEN' and yeuCau.trang_thai != 'TU_CHOI' and yeuCau.trang_thai != 'DA_HUY'}"><div class="return-admin-form" style="margin-top:22px"><div class="wide"><label for="xuLyGhiChu">Ghi chú / kết quả kiểm tra</label><textarea class="input" id="xuLyGhiChu" name="ghiChu" maxlength="700" ${yeuCau.trang_thai == 'DANG_KIEM_TRA' ? 'required minlength="10"' : ''}><c:out value="${formXuLy.ghiChu}"/></textarea></div>
<c:if test="${yeuCau.trang_thai == 'DA_DUYET_HOAN_TRA'}"><p class="return-refund-note wide">Chỉ ghi nhận sau khi đã trả tiền cho khách. Thao tác này lưu chứng từ hoàn tiền và cập nhật tồn kho.</p><div><label for="tienDaHoan">Số tiền đã hoàn (đ) *</label><div class="return-refund-input"><input class="input" id="tienDaHoan" name="soTien" type="number" min="0" step="1" required><button type="button" class="button secondary" data-fill-refund="<c:out value='${yeuCau.so_tien_hoan}'/>">Điền đủ tiền hoàn</button></div></div><div><label for="maHoan">Mã phiếu chi / mã giao dịch *</label><input class="input" id="maHoan" name="maGiaoDich" maxlength="100" required minlength="3" value="<c:out value='${empty formXuLy.maGiaoDich ? maPhieuHoan : formXuLy.maGiaoDich}'/>"></div></c:if></div>
<div class="return-admin-actions" style="margin-top:20px">
<c:if test="${yeuCau.trang_thai == 'CHO_XAC_NHAN'}"><button class="button" name="action" value="duyet">Duyệt sản phẩm đã chọn</button></c:if>
<c:if test="${yeuCau.trang_thai == 'DANG_GUI_HANG' or (yeuCau.trang_thai == 'DA_XAC_NHAN' and yeuCau.hinh_thuc_tra == 'TAI_CUA_HANG')}"><button class="button" name="action" value="nhan-hang">Xác nhận đã nhận hàng trả</button></c:if>
<c:if test="${yeuCau.trang_thai == 'DA_NHAN_HANG'}"><button class="button" name="action" value="kiem-tra">Bắt đầu kiểm tra</button></c:if>
<c:if test="${yeuCau.trang_thai == 'DANG_KIEM_TRA'}"><button class="button" name="action" value="duyet-hoan">Duyệt hoàn tiền sản phẩm đã chọn</button></c:if>
<c:if test="${yeuCau.trang_thai == 'DA_DUYET_HOAN_TRA'}"><button class="button" name="action" value="hoan-tien">Ghi nhận đã hoàn tiền</button></c:if>
<c:if test="${yeuCau.trang_thai == 'CHO_XAC_NHAN' or yeuCau.trang_thai == 'DANG_KIEM_TRA'}"><button class="button danger" name="action" value="tu-choi" formnovalidate>Từ chối (nhập lý do)</button></c:if>
</div></c:if></form>
<h3 style="margin-top:30px">Lịch sử xử lý</h3><ol class="return-progress"><c:forEach items="${lichSuTra}" var="l"><li><strong><fmt:formatDate value="${l.ngay_tao}" pattern="dd/MM/yyyy HH:mm"/></strong><p><c:out value="${l.noi_dung}"/></p></li></c:forEach></ol>
</c:when><c:when test="${xemHangLoi}"><p class="muted">Hàng lỗi được tách riêng, không cộng vào tồn kho đang bán. Hiển thị 100 bản ghi gần nhất.</p><div class="table-scroll"><table class="table"><thead><tr><th>STT</th><th>Yêu cầu</th><th>Sản phẩm</th><th>Mẫu</th><th>Số lượng</th><th>Lý do</th></tr></thead><tbody><c:forEach items="${hangLoi}" var="d" varStatus="st"><tr><td>${st.count}</td><td><a href="/quan-ly/tra-hang/${d.id_yeu_cau}"><c:out value="${d.ma_yeu_cau}"/></a></td><td><c:out value="${d.ten_san_pham}"/></td><td><c:out value="${d.ma_chi_tiet_san_pham}"/> · <c:out value="${d.ten_mau_sac}"/> · <c:out value="${d.ten_kich_thuoc}"/></td><td>${d.so_luong}</td><td><c:out value="${d.ghi_chu}"/></td></tr></c:forEach></tbody></table></div></c:when>
<c:otherwise><form method="get" action="/quan-ly/tra-hang" class="return-admin-form" style="margin-bottom:22px"><div><label for="timTraHang">Tìm mã yêu cầu / hóa đơn / SĐT</label><input class="input" id="timTraHang" name="tuKhoa" maxlength="100" value="<c:out value='${tuKhoa}'/>"></div><div><label for="locTraHang">Trạng thái</label><select class="input" id="locTraHang" name="trangThai"><option value="">Tất cả trạng thái</option><c:forEach items="${trangThaiTra}" var="t"><option value="${t.key}" ${trangThai == t.key ? 'selected' : ''}><c:out value="${t.value}"/></option></c:forEach></select></div><div class="return-admin-actions wide"><button class="button">Lọc yêu cầu</button><a class="button secondary" href="/quan-ly/tra-hang">Xóa bộ lọc</a></div></form>
<div class="table-scroll"><table class="table"><thead><tr><th>STT</th><th>Yêu cầu / hóa đơn</th><th>Khách hàng</th><th>Ngày tạo</th><th>Tiền hoàn</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${danhSach}" var="y" varStatus="st"><tr><td>${(trang-1)*10+st.count}</td><td><strong><c:out value="${y.ma_yeu_cau}"/></strong><div class="muted"><c:out value="${y.ma_hoa_don}"/></div></td><td><c:out value="${y.ten_khach_hang}"/></td><td><fmt:formatDate value="${y.ngay_tao}" pattern="dd/MM/yyyy HH:mm"/></td><td><fmt:formatNumber value="${y.so_tien_hoan}" maxFractionDigits="2"/> đ</td><td><c:out value="${y.ten_trang_thai}"/></td><td><a class="button secondary" href="/quan-ly/tra-hang/${y.id}">Xem chi tiết</a></td></tr></c:forEach><c:if test="${empty danhSach}"><tr><td colspan="7">Chưa có yêu cầu phù hợp.</td></tr></c:if></tbody></table></div>
<c:if test="${not empty trang}"><nav class="return-pagination" aria-label="Phân trang"><span>${tong} yêu cầu · Trang ${trang}/${soTrang}</span><c:forEach begin="${trang > 2 ? trang-2 : 1}" end="${trang+2 < soTrang ? trang+2 : soTrang}" var="p"><c:url var="urlTrang" value="/quan-ly/tra-hang"><c:param name="tuKhoa" value="${tuKhoa}"/><c:param name="trangThai" value="${trangThai}"/><c:param name="trang" value="${p}"/></c:url><a class="button secondary ${p == trang ? 'current' : ''}" href="${urlTrang}">${p}</a></c:forEach><c:if test="${trang < soTrang}"><c:url var="urlTiep" value="/quan-ly/tra-hang"><c:param name="tuKhoa" value="${tuKhoa}"/><c:param name="trangThai" value="${trangThai}"/><c:param name="trang" value="${trang+1}"/></c:url><a class="button secondary" href="${urlTiep}">Tiếp →</a></c:if></nav></c:if>
</c:otherwise></c:choose></div></section></main></div></div><script>
(function(){if(window.VictorChonDuyetTra)return;window.VictorChonDuyetTra=true;
document.addEventListener('click',function(e){var button=e.target.closest('[data-fill-refund]');if(!button)return;
 var form=button.closest('form'),input=form&&form.querySelector('[name="soTien"]'),amount=Number(button.dataset.fillRefund);
 if(!input||!Number.isFinite(amount)||amount<=0)return;
 input.value=String(amount);input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));input.focus();
});
function update(form){if(!form)return;var boxes=Array.from(form.querySelectorAll('[data-return-choice]')),selected=boxes.filter(function(b){return b.checked;});
 boxes.forEach(function(b){form.querySelectorAll('[data-return-stock="'+b.dataset.row+'"],[data-return-fault="'+b.dataset.row+'"]').forEach(function(input){input.disabled=!b.checked;input.required=b.checked;});});
 var all=form.querySelector('[data-return-select-all]');if(all){all.checked=boxes.length>0&&selected.length===boxes.length;all.indeterminate=selected.length>0&&selected.length<boxes.length;}
 var total=form.querySelector('[data-return-selected-total]');if(total)total.textContent='Đã chọn '+selected.length+' sản phẩm · Tiền hoàn: '+new Intl.NumberFormat('vi-VN',{maximumFractionDigits:2}).format(selected.reduce(function(sum,b){return sum+Number(b.dataset.amount||0);},0))+' đ';
}
document.addEventListener('input',function(e){var input=e.target;if(!input.matches('[data-return-stock],[data-return-fault]'))return;
 var form=input.closest('form'),row=input.dataset.returnStock||input.dataset.returnFault;
 var other=form.querySelector(input.hasAttribute('data-return-stock')?'[data-return-fault="'+row+'"]':'[data-return-stock="'+row+'"]');
 var value=Number(input.value),qty=Number(input.dataset.returnQuantity);
 if(other&&input.value!==''&&Number.isInteger(value)&&value>=0&&value<=qty){other.value=qty-value;other.setCustomValidity('');if(window.VictorKiemTraDuLieu)window.VictorKiemTraDuLieu();}
});
document.addEventListener('change',function(e){if(!e.target.matches('[data-return-choice],[data-return-select-all]'))return;var form=e.target.closest('form');if(e.target.matches('[data-return-select-all]'))form.querySelectorAll('[data-return-choice]').forEach(function(b){b.checked=e.target.checked;});update(form);});
update(document.querySelector('[data-return-approval]'));
}());
</script></body></html>
