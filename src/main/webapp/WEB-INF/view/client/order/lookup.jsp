<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tra cứu đơn hàng — VictorSport</title><link rel="icon" href="/logo/favicon-victorsport.svg"><link rel="stylesheet" href="/css/trang-chu.css"><link rel="stylesheet" href="/css/tai-khoan-khach.css"><link rel="stylesheet" href="/css/giao-dien-chung.css?v=20261023-complete-1"></head><body><%@ include file="/WEB-INF/view/client/layout/header.jsp" %>
<main class="store-container self-account"><section class="account-card"><p class="eyebrow">ĐƠN HÀNG VICTORSPORT</p><h1>Tra cứu đơn hàng</h1><p class="subtle">Dành cho đơn đặt không đăng nhập. Khách có tài khoản xem trong “Đơn hàng của tôi”.</p><c:if test="${not empty error}"><div class="account-error" role="alert" data-vs-flash="error"><c:out value="${error}"/></div></c:if>
<form class="account-form" method="post"><label for="ma">Mã đơn hàng</label><input id="ma" name="ma" maxlength="7" pattern="[hH][dD][0-9]{5}" placeholder="VD: HD00035" required><label for="sdt">Số điện thoại đặt hàng</label><input type="tel" id="sdt" name="sdt" pattern="0[0-9]{9}" maxlength="10" required><button class="store-button">Tra cứu</button></form></section></main></body></html>
