<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Trả hàng và hoàn tiền — VictorSport</title><link rel="icon" href="/logo/favicon-victorsport.svg">
<link rel="stylesheet" href="/css/trang-chu.css?v=20261107-balanced"><link rel="stylesheet" href="/css/don-hang.css?v=20261109-recipient-button"><link rel="stylesheet" href="/css/giao-dien-chung.css?v=20261107-readable">
<style>.return-upload-preview{display:flex;flex-wrap:wrap;gap:10px}.return-upload-item{position:relative;width:88px;margin:0}.return-upload-item img{display:block;width:88px;height:88px;object-fit:cover;border:1px solid #dfe7f1;border-radius:10px}.return-upload-item figcaption{font-size:11px;color:#74859a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:5px}.return-upload-item button{position:absolute;right:4px;top:4px;width:24px;height:24px;border:1px solid #e4eaf2;border-radius:50%;background:white;color:#be4242;cursor:pointer;font-size:18px;line-height:20px;box-shadow:0 2px 6px #142d501a}.return-upload-error{color:#bc4540;font-size:13px;line-height:1.6}.return-page{max-width:1120px;margin:30px auto;padding:0 20px 50px}.return-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}.return-heading h1{margin:10px 0}.return-page .account-card{margin-bottom:20px;padding:26px;background:#fff;border:1px solid #e2e9f3;border-radius:20px}.return-page table{width:100%;border-collapse:collapse;min-width:640px}.return-page th,.return-page td{padding:14px 12px;text-align:left;border-bottom:1px solid #e8eef5;vertical-align:middle}.return-page th{background:#f5f8fc;color:#617693;font-size:13px}.return-page .table-scroll{overflow:auto}.return-page input:not([type=checkbox]),.return-page select,.return-page textarea{width:100%;font:inherit;padding:12px 14px;border:1px solid #d7e2ef;border-radius:10px;background:#fff;color:#173254}.return-page input[type=checkbox]{width:18px;height:18px;accent-color:#ff6a23}.return-page input[type=number]{min-width:88px;max-width:130px}.return-fields{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:22px 0}.return-fields label{display:block;margin-bottom:8px;font-weight:600;color:#506882}.return-fields .wide{grid-column:1/-1}.return-bank{display:contents}.return-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:20px}.return-actions button{font:inherit;cursor:pointer;border:0}.return-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.return-state{padding:8px 13px;border-radius:20px;background:#fff0e4;color:#ae581d;font-weight:600;font-size:13px;white-space:nowrap}.return-photos{display:flex;gap:12px;flex-wrap:wrap}.return-photos img{width:108px;height:108px;object-fit:cover;border:1px solid #e1e9f2;border-radius:12px}.return-timeline{padding-left:22px}.return-timeline li{padding:8px 0 16px;color:#617793}.return-total{font-size:25px;font-weight:800;color:#f36b27}.return-note{background:#f4f8fc;color:#6b7f98;border:1px solid #e2eaf4;padding:14px 18px;border-radius:12px;line-height:1.7}.return-danger{background:#fff0ef;color:#c34646;border:1px solid #f2d8d4;border-radius:10px;padding:12px 18px}.return-neutral{background:#eff4fa;color:#25466a;padding:12px 18px;border-radius:10px}.return-fields textarea{min-height:100px}.return-error{background:#fff0ef;color:#b4433e;padding:14px 18px;border-radius:12px;margin-bottom:18px}.return-success{background:#edf9f2;color:#267650;padding:14px 18px;border-radius:12px;margin-bottom:18px}@media(max-width:700px){.return-store .announcement{display:none}.return-fields,.return-grid{grid-template-columns:1fr}.return-heading{align-items:flex-start;flex-direction:column;gap:8px}.return-page .account-card{padding:20px}.return-page th,.return-page td{padding:11px 9px}.return-heading h1{font-size:27px}}</style></head>
<body class="store-page return-store"><%@ include file="/WEB-INF/view/client/layout/header.jsp" %>
<main class="return-page">
<c:set var="duongDanDon" value="${quanTri ? '/quan-ly/hoa-don/' : (empty don.id_khach_hang ? '/don-vang-lai/' : '/don-hang/')}"/>
<div class="return-heading"><div><a href="${duongDanDon}${don.id}">← Đơn hàng <c:out value="${don.ma_hoa_don}"/></a><h1>Trả hàng &amp; hoàn tiền</h1></div><c:if test="${not empty yeuCau}"><span class="return-state"><c:out value="${yeuCau.ten_trang_thai}"/></span></c:if></div>
<c:if test="${not empty error}"><div class="return-error" role="alert"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="return-success" role="status"><c:out value="${success}"/></div></c:if>
<c:choose><c:when test="${empty yeuCau}">
<section class="account-card"><h2>Tạo yêu cầu trả hàng</h2><p class="return-note">Trong vòng 15 ngày từ khi nhận hàng. Tiền hoàn được tính từ tiền hàng thực trả sau giảm giá, không gồm phí vận chuyển.</p>
<c:choose><c:when test="${not empty loiDieuKien}"><p class="return-error"><c:out value="${loiDieuKien}"/></p></c:when><c:otherwise>
<form method="post" enctype="multipart/form-data" action="${baseTra}/don/${don.id}">
<input type="hidden" name="csrf" value="<c:out value='${csrfTraHang}'/>"><input type="hidden" name="maTao" value="<c:out value='${maTao}'/>">
<div class="table-scroll"><table><thead><tr><th>Chọn</th><th>Sản phẩm</th><th>Đã mua / đã trả</th><th>Số lượng trả</th><th>Giá trị còn được hoàn</th></tr></thead><tbody>
<c:forEach items="${dong}" var="d"><tr><td><input type="checkbox" name="dong" value="${d.id}" ${d.con_tra <= 0 ? 'disabled' : ''} ${dongDaChon.contains(d.id) ? 'checked' : ''} aria-label="Chọn sản phẩm trả"></td><td><strong><c:out value="${d.ten_san_pham}"/></strong><div class="subtle"><c:out value="${d.gioi_tinh}"/> · <c:out value="${d.ten_mau_sac}"/> · <c:out value="${d.ten_kich_thuoc}"/></div></td><td>${d.so_luong} / ${d.so_luong_da_tra}</td><td><c:set var="slKey" value="sl_${d.id}"/><input type="number" name="sl_${d.id}" min="1" max="${d.con_tra}" step="1" value="<c:out value='${empty formTraHang[slKey] ? 1 : formTraHang[slKey]}'/>" ${d.con_tra <= 0 ? 'disabled' : ''} aria-label="Số lượng trả"></td><td><fmt:formatNumber value="${d.gia_tri_hoan}" maxFractionDigits="2"/> đ</td></tr></c:forEach>
</tbody></table></div>
<div class="return-fields"><div><label for="lyDoTra">Lý do trả hàng *</label><select name="lyDo" id="lyDoTra" required><option value="">Chọn lý do</option><c:forEach items="${lyDo}" var="l"><option ${formTraHang.lyDo == l ? 'selected' : ''}><c:out value="${l}"/></option></c:forEach></select></div>
<div><label for="hinhThucTra">Hình thức trả hàng *</label><select id="hinhThucTra" name="hinhThuc" required><option value="GUI_HANG" ${don.loai_don == 0 ? 'disabled' : ''} ${formTraHang.hinhThuc == 'GUI_HANG' ? 'selected' : ''}>Gửi hàng về cửa hàng</option><option value="TAI_CUA_HANG" ${don.loai_don == 0 or formTraHang.hinhThuc == 'TAI_CUA_HANG' ? 'selected' : ''}>Mang đến cửa hàng</option></select></div>
<div class="wide"><label for="ghiChuTra">Mô tả chi tiết</label><textarea id="ghiChuTra" name="ghiChu" maxlength="1000"><c:out value="${formTraHang.ghiChu}"/></textarea></div>
<div><label for="anhTra">Ảnh minh chứng *</label><input id="anhTra" type="file" name="minhChung" accept="image/jpeg,image/png" multiple required><p class="subtle" id="demAnhTra" aria-live="polite">Đã chọn 0/5 ảnh · JPG/PNG, tối đa 5 MB mỗi ảnh.</p><div id="xemAnhTra" class="return-upload-preview"></div><p id="loiAnhTra" class="return-upload-error" role="alert" hidden></p></div>
<div><label for="cachHoan">Nhận hoàn tiền qua *</label><select name="phuongThuc" id="cachHoan" required><option value="BANK" ${formTraHang.phuongThuc == 'BANK' ? 'selected' : ''}>Tài khoản ngân hàng</option><option value="CASH" ${formTraHang.phuongThuc == 'CASH' ? 'selected' : ''}>Tiền mặt tại cửa hàng</option></select></div>
<div data-bank-field><label for="bankHoan">Ngân hàng *</label><select id="bankHoan" name="nganHang"><option value="">Chọn ngân hàng</option><c:forEach items="${nganHang}" var="b"><option ${formTraHang.nganHang == b ? 'selected' : ''}><c:out value="${b}"/></option></c:forEach></select></div>
<div data-bank-field><label for="stkHoan">Số tài khoản *</label><input id="stkHoan" name="soTaiKhoan" inputmode="numeric" pattern="[0-9]{6,34}" maxlength="34" value="<c:out value='${formTraHang.soTaiKhoan}'/>"></div>
<div data-bank-field class="wide"><label for="chuHoan">Tên chủ tài khoản *</label><input id="chuHoan" name="chuTaiKhoan" maxlength="100" value="<c:out value='${formTraHang.chuTaiKhoan}'/>"></div></div>
<div class="return-actions"><button class="store-button" type="submit">Gửi yêu cầu trả hàng</button><a class="return-neutral" href="${duongDanDon}${don.id}">Quay lại đơn hàng</a></div></form>
</c:otherwise></c:choose></section>
<section class="account-card"><h2>Yêu cầu của đơn hàng</h2><c:if test="${empty cacYeuCau}"><p class="subtle">Chưa có yêu cầu trả hàng.</p></c:if><c:forEach items="${cacYeuCau}" var="y"><div class="don-hang-row"><div><strong><c:out value="${y.ma_yeu_cau}"/></strong><p class="subtle"><c:out value="${y.ten_trang_thai}"/> · <fmt:formatDate value="${y.ngay_tao}" pattern="dd/MM/yyyy HH:mm"/></p></div><a class="return-neutral" href="${baseTra}/${y.id}">Xem chi tiết</a></div></c:forEach></section>
</c:when><c:otherwise>
<section class="account-card"><div class="return-heading"><h2><c:out value="${yeuCau.ma_yeu_cau}"/></h2><span class="return-total"><fmt:formatNumber value="${yeuCau.so_tien_hoan}" maxFractionDigits="2"/> đ</span></div><p><strong>Lý do:</strong> <c:out value="${yeuCau.ly_do}"/></p><p><c:out value="${yeuCau.ghi_chu}"/></p>
<div class="table-scroll"><table><thead><tr><th>STT</th><th>Sản phẩm</th><th>Số lượng trả</th><th>Kết quả duyệt</th><th>Tiền hoàn</th></tr></thead><tbody><c:forEach items="${dongTra}" var="d" varStatus="st"><tr><td>${st.count}</td><td><strong><c:out value="${d.ten_san_pham}"/></strong><div class="subtle"><c:out value="${d.gioi_tinh}"/> · <c:out value="${d.ten_mau_sac}"/> · <c:out value="${d.ten_kich_thuoc}"/></div></td><td>${d.so_luong}</td><td>${yeuCau.trang_thai == 'CHO_XAC_NHAN' ? 'Chờ duyệt' : (yeuCau.trang_thai == 'DA_HUY' ? 'Đã hủy' : (yeuCau.trang_thai == 'TU_CHOI' or not d.duoc_duyet ? 'Không duyệt' : 'Được duyệt'))}</td><td><fmt:formatNumber value="${yeuCau.trang_thai != 'CHO_XAC_NHAN' and (yeuCau.trang_thai == 'TU_CHOI' or not d.duoc_duyet) ? 0 : d.so_tien_hoan}" maxFractionDigits="2"/> đ</td></tr></c:forEach></tbody></table></div>
<div class="return-photos"><c:forEach items="${anh}" var="a"><a href="${baseTra}/${yeuCau.id}/anh/${a.id}" target="_blank" rel="noopener"><img src="${baseTra}/${yeuCau.id}/anh/${a.id}" alt="Ảnh minh chứng trả hàng"></a></c:forEach></div></section>
<div class="return-grid"><section class="account-card"><h2>Thông tin hoàn tiền</h2><p><strong>Hình thức:</strong> ${yeuCau.phuong_thuc_hoan == 'BANK' ? 'Tài khoản ngân hàng' : 'Tiền mặt tại cửa hàng'}</p><c:if test="${yeuCau.phuong_thuc_hoan == 'BANK'}"><p><c:out value="${yeuCau.ngan_hang}"/> · <c:out value="${yeuCau.so_tai_khoan}"/></p><p><c:out value="${yeuCau.chu_tai_khoan}"/></p></c:if><c:forEach items="${hoanTien}" var="h"><p><strong>Đã hoàn:</strong> <fmt:formatNumber value="${h.so_tien}" maxFractionDigits="2"/> đ</p><p>Mã giao dịch: <c:out value="${h.ma_giao_dich}"/></p></c:forEach></section>
<section class="account-card"><h2>Gửi hàng về</h2><p>${yeuCau.hinh_thuc_tra == 'GUI_HANG' ? 'Gửi qua đơn vị vận chuyển' : 'Mang đến cửa hàng VictorSport, Hà Nội'}</p><c:if test="${not empty yeuCau.ma_van_don}"><p><c:out value="${yeuCau.hang_van_chuyen}"/> · <c:out value="${yeuCau.ma_van_don}"/></p></c:if>
<c:if test="${yeuCau.trang_thai == 'DA_XAC_NHAN' and yeuCau.hinh_thuc_tra == 'GUI_HANG'}"><form method="post" action="${baseTra}/${yeuCau.id}/gui-hang"><input type="hidden" name="csrf" value="<c:out value='${csrfTraHang}'/>"><div class="return-fields"><div><label for="hangVc">Đơn vị vận chuyển *</label><input id="hangVc" name="hangVanChuyen" required minlength="2" maxlength="100"></div><div><label for="maVc">Mã vận đơn *</label><input id="maVc" name="maVanDon" required pattern="[A-Za-z0-9_-]{3,100}" maxlength="100"></div></div><button class="store-button" type="submit">Xác nhận đã gửi hàng</button></form></c:if>
</section></div>
<c:if test="${yeuCau.trang_thai == 'CHO_XAC_NHAN' or yeuCau.trang_thai == 'DA_XAC_NHAN'}"><section class="account-card"><form method="post" action="${baseTra}/${yeuCau.id}/huy"><input type="hidden" name="csrf" value="<c:out value='${csrfTraHang}'/>"><button class="return-danger" type="submit">Hủy yêu cầu trả hàng</button></form></section></c:if>
<section class="account-card"><h2>Tiến trình xử lý</h2><ol class="return-timeline"><c:forEach items="${lichSuTra}" var="l"><li><strong><fmt:formatDate value="${l.ngay_tao}" pattern="dd/MM/yyyy HH:mm"/></strong><p><c:out value="${l.noi_dung}"/></p></li></c:forEach></ol></section>
</c:otherwise></c:choose>
</main><script>
(function(){var method=document.getElementById('cachHoan');if(!method)return;function change(){document.querySelectorAll('[data-bank-field]').forEach(function(el){var on=method.value==='BANK';el.hidden=!on;el.querySelectorAll('input,select').forEach(function(i){i.disabled=!on;i.required=on;});});}method.addEventListener('change',change);change();}());
(function(){
    var input=document.getElementById('anhTra');if(!input)return;
    var preview=document.getElementById('xemAnhTra'),counter=document.getElementById('demAnhTra'),error=document.getElementById('loiAnhTra');
    var selected=[],urls=[];
    function same(a,b){return a.name===b.name&&a.size===b.size&&a.lastModified===b.lastModified;}
    function render(){
        var transfer=new DataTransfer();selected.forEach(function(file){transfer.items.add(file);});input.files=transfer.files;
        urls.forEach(function(url){URL.revokeObjectURL(url);});urls=[];preview.replaceChildren();
        counter.textContent='Đã chọn '+selected.length+'/5 ảnh · JPG/PNG, tối đa 5 MB mỗi ảnh.';
        selected.forEach(function(file,index){
            var figure=document.createElement('figure'),image=document.createElement('img'),caption=document.createElement('figcaption'),remove=document.createElement('button');
            figure.className='return-upload-item';var url=URL.createObjectURL(file);urls.push(url);image.src=url;image.alt='Ảnh minh chứng '+(index+1);caption.textContent=file.name;
            remove.type='button';remove.textContent='×';remove.setAttribute('aria-label','Xóa ảnh '+file.name);
            remove.addEventListener('click',function(){selected.splice(index,1);error.hidden=true;render();input.dispatchEvent(new Event('input',{bubbles:true}));});
            figure.append(image,remove,caption);preview.append(figure);
        });
    }
    input.addEventListener('change',function(){
        var messages=[];Array.from(input.files).forEach(function(file){
            if(selected.some(function(old){return same(old,file);}))return;
            if(!/\.(jpe?g|png)$/i.test(file.name)||!file.size||file.size>5*1024*1024){messages.push('Ảnh phải là JPG/PNG và không vượt quá 5 MB.');return;}
            if(selected.length>=5){messages.push('Chỉ được chọn tối đa 5 ảnh. Xóa bớt ảnh để thêm ảnh khác.');return;}
            selected.push(file);
        });
        error.textContent=Array.from(new Set(messages)).join(' ');error.hidden=!messages.length;render();
    });
    input.form.addEventListener('reset',function(){selected=[];error.hidden=true;render();});
}());
</script></body></html>
