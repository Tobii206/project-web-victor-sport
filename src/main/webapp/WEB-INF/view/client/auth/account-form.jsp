<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${tieuDe}"/> — VictorSport</title><link rel="icon" href="/logo/favicon-victorsport.svg"><link rel="stylesheet" href="/css/trang-chu.css"><link rel="stylesheet" href="/css/tai-khoan-khach.css?v=1"><link rel="stylesheet" href="/css/giao-dien-chung.css?v=20261023-complete-1"></head>
<body><%@ include file="/WEB-INF/view/client/layout/header.jsp" %><main class="store-container self-account"><a class="account-back" href="${cheDo == 'chinh-sua' or cheDo == 'doi-mat-khau' ? '/tai-khoan' : '/login'}">← Quay lại</a><section class="account-card"><p class="eyebrow">TÀI KHOẢN VICTORSPORT</p><h1><c:out value="${tieuDe}"/></h1>
<c:if test="${not empty error}"><div class="account-error" role="alert" data-vs-flash="error"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><p class="self-success" role="status" data-vs-flash="success"><c:out value="${success}"/></p></c:if>
<c:choose><c:when test="${cheDo == 'quen-mat-khau'}">
<c:if test="${not guiEmailSanSang}"><p class="subtle">Cửa hàng chưa bật gửi mã qua email. Liên hệ 0325327602 để được hỗ trợ.</p></c:if>
<form class="account-form" method="post" action="/quen-mat-khau"><input type="hidden" name="csrfTaiKhoan" value="${csrfTaiKhoan}"><label for="emailGui">Email đăng ký</label><input type="email" id="emailGui" name="email" maxlength="100" value="<c:out value='${email}'/>" required><button class="store-button" ${not guiEmailSanSang ? 'disabled' : ''}>Gửi mã xác minh</button></form>
<hr><form class="account-form" method="post" action="/dat-lai-mat-khau"><input type="hidden" name="csrfTaiKhoan" value="${csrfTaiKhoan}"><label for="emailDatLai">Email đăng ký</label><input type="email" id="emailDatLai" name="email" maxlength="100" value="<c:out value='${email}'/>" required><label for="ma">Mã xác minh</label><input id="ma" name="ma" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required><label for="matKhau">Mật khẩu mới</label><input type="password" id="matKhau" name="matKhau" minlength="6" maxlength="72" autocomplete="new-password" required><label for="nhapLai">Nhập lại mật khẩu mới</label><input type="password" id="nhapLai" name="nhapLai" minlength="6" maxlength="72" autocomplete="new-password" required><button class="store-button">Đặt lại mật khẩu</button></form>
</c:when><c:otherwise>
<form class="account-form" method="post" action="${cheDo == 'dang-ky' ? '/dang-ky' : (cheDo == 'chinh-sua' ? '/tai-khoan/chinh-sua' : '/tai-khoan/doi-mat-khau')}"><input type="hidden" name="csrfTaiKhoan" value="${csrfTaiKhoan}">
<c:if test="${cheDo != 'doi-mat-khau'}"><label for="hoTen">Họ và tên</label><input id="hoTen" name="hoTen" maxlength="100" value="<c:out value='${duLieu.hoTen}'/>" autocomplete="name" required><label for="email">Email</label><input type="email" id="email" name="email" maxlength="100" value="<c:out value='${duLieu.email}'/>" pattern="[a-zA-Z0-9]+([._%+\-][a-zA-Z0-9]+)*@[gG][mM][aA][iI][lL]\.[cC][oO][mM]" title="Email có dạng ten@gmail.com" autocomplete="email" required><label for="sdt">Số điện thoại</label><input id="sdt" name="sdt" type="tel" pattern="0[0-9]{9}" maxlength="10" value="<c:out value='${duLieu.sdt}'/>" autocomplete="tel" required></c:if>
<c:if test="${cheDo == 'doi-mat-khau'}"><label for="matKhauCu">Mật khẩu hiện tại</label><input id="matKhauCu" type="password" name="matKhauCu" autocomplete="current-password" maxlength="255" required></c:if>
<c:if test="${cheDo != 'chinh-sua'}"><label for="matKhau">${cheDo == 'dang-ky' ? 'Mật khẩu' : 'Mật khẩu mới'}</label><input id="matKhau" type="password" name="matKhau" minlength="6" maxlength="72" autocomplete="new-password" required><label for="nhapLai">Nhập lại mật khẩu</label><input id="nhapLai" type="password" name="nhapLai" minlength="6" maxlength="72" autocomplete="new-password" required><p class="subtle">Mật khẩu có ít nhất 6 ký tự.</p></c:if>
<button class="store-button">${cheDo == 'dang-ky' ? 'Tạo tài khoản' : 'Lưu thay đổi'}</button></form>
</c:otherwise></c:choose></section></main></body></html>
